{
  "name": "@mcp-core/mcp-knot",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev:fe": "pnpm --filter @mcp-core/mcp-knot-web dev",
    "dev:api": "pnpm --filter @mcp-core/mcp-knot-api dev",
    "dev:cli": "pnpm --filter @mcp-core/mcp-knot-cli dev",
    "build": "pnpm --filter \"@mcp-core/*\" build",
    "build:share": "pnpm --filter @mcp-core/mcp-knot-share build",
    "build:protocol": "pnpm --filter @mcp-core/mcp-knot-protocol build",
    "build:core": "pnpm --filter @mcp-core/mcp-knot-core build",
    "build:api": "pnpm --filter @mcp-core/mcp-knot-api build",
    "build:cli": "pnpm --filter @mcp-core/mcp-knot-cli build",
    "build:fe": "pnpm --filter @mcp-core/mcp-knot-web build",
    "build:production": "pnpm build:share && pnpm build:protocol && pnpm build:core && pnpm build:api && pnpm build:cli && pnpm build:fe",
    "check": "pnpm --filter \"@mcp-core/*\" check",
    "check:ci": "oxlint --ignore-path .oxlintignore . && oxfmt --check .",
    "check:all": "oxlint --fix --ignore-path .oxlintignore . && oxfmt .",
    "inspector": "pnpx @modelcontextprotocol/inspector",
    "test": "vitest --run",
    "test:skills": "vitest --run --project share --project core --project api-unit packages/core/src/skills packages/share/src/config/schemas/skills.schema.unit.test.ts backend/src/api/skills backend/src/api/mcp/skills-protocol.integration.test.ts backend/src/services/skills-config.integration.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest --run --project api-e2e",
    "test:coverage": "vitest --run --coverage",
    "test:debug": "VITEST_DEBUG=true vitest --run",
    "mutation": "node .github/scripts/mutation.mjs",
    "mutation:full": "node .github/scripts/mutation.mjs --force",
    "test:conformance": "bash scripts/conformance/run.sh",
    "coverage:report": "tsx scripts/check-coverage.ts",
    "coverage:merge": "tsx scripts/merge-coverage.ts",
    "coverage:full": "pnpm test:coverage && pnpm coverage:merge && pnpm coverage:report",
    "ci:test": "pnpm run test:release && pnpm run test:mutation-runner && pnpm test:coverage",
    "ci:build": "pnpm install --frozen-lockfile && pnpm build:production",
    "ci:check": "pnpm check:ci && pnpm ci:test",
    "start:api": "pnpm --filter @mcp-core/mcp-knot-api start",
    "start:cli": "pnpm --filter @mcp-core/mcp-knot-cli start",
    "clean": "pnpm --filter \"@mcp-core/*\" exec rm -rf dist coverage",
    "clean:all": "pnpm clean && rm -rf node_modules packages/*/node_modules backend/node_modules frontend/node_modules",
    "release:dry-run": "pnpm --filter \"./packages/**\" exec rm -rf dist && pnpm build:share && pnpm build:protocol && pnpm build:core && pnpm build:cli && node scripts/check-release-packages.cjs",
    "typecheck": "pnpm --filter \"!@mcp-core/mcp-knot-web\" -r exec tsc --noEmit && pnpm typecheck:fe",
    "typecheck:fe": "pnpm --filter @mcp-core/mcp-knot-web typecheck",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:push": "node scripts/release.cjs push",
    "release:check": "node scripts/release.cjs check",
    "test:release": "node --test scripts/release.test.cjs",
    "test:mutation-runner": "node --test scripts/mutation-runner.test.mjs",
    "release:validate": "pnpm run check:ci && pnpm run test:release && pnpm run clean && pnpm run build:production && pnpm run typecheck && pnpm test && node scripts/check-release-packages.cjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "tsx": "^4.7.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@10.6.4",
  "pnpm": {
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
