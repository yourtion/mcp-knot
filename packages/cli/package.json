{
  "name": "@mcp-core/mcp-knot-cli",
  "version": "0.0.1",
  "private": false,
  "description": "MCP Knot CLI包 - 提供命令行界面的MCP服务聚合器",
  "keywords": [
    "cli",
    "command-line",
    "hub",
    "mcp",
    "model-context-protocol"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/mcp-knot.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mcp-knot": "./bin/mcp-knot.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "oxlint --fix src/ && oxfmt src/",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:debug": "VITEST_DEBUG=true vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:debug": "VITEST_DEBUG=true vitest --run --coverage",
    "test:e2e": "vitest --run src/e2e/",
    "test:e2e:watch": "vitest src/e2e/",
    "test:e2e:debug": "VITEST_DEBUG=true vitest --run src/e2e/",
    "test:integration": "vitest --run src/integration/",
    "test:integration:debug": "VITEST_DEBUG=true vitest --run src/integration/",
    "test:all": "vitest --run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mcp-core/mcp-knot-core": "workspace:*",
    "@mcp-core/mcp-knot-protocol": "workspace:*",
    "@mcp-core/mcp-knot-share": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.6.4"
}
