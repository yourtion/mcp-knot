{
  "name": "@mcp-core/mcp-knot-protocol",
  "version": "0.1.0",
  "description": "MCP Knot 协议兼容层：双向 era 翻译、归一化模型、统一错误",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/mcp-knot.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "oxlint --fix src/ && oxfmt src/",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@mcp-core/mcp-knot-share": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.6.4"
}
