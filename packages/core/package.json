{
  "name": "@mcp-core/mcp-knot-core",
  "version": "0.1.1",
  "private": false,
  "description": "MCP Knot核心包 - 提供MCP服务管理、连接管理和工具调用的核心功能",
  "keywords": [
    "core",
    "hub",
    "mcp",
    "model-context-protocol"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/mcp-knot.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/test-utils",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils/logger": {
      "types": "./dist/utils/logger.d.ts",
      "import": "./dist/utils/logger.js"
    },
    "./api-to-mcp": {
      "types": "./dist/api-to-mcp/index.d.ts",
      "import": "./dist/api-to-mcp/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "oxlint --fix src/ && oxfmt src/",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:debug": "VITEST_DEBUG=true vitest",
    "test:coverage:debug": "VITEST_DEBUG=true vitest --run --coverage",
    "coverage:open": "open coverage/index.html"
  },
  "dependencies": {
    "@mcp-core/mcp-knot-share": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "axios": "^1.6.7",
    "jsonata": "^2.0.3",
    "yaml": "2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsonata": "^1.5.1",
    "@types/node": "^20.11.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.6.4"
}
