# MCP Knot 生产环境配置示例
#
# 复制此文件为 .env.production 并填写实际值。
#
# 重要：MCP Knot 的大部分配置通过 JSON 配置文件管理（而非环境变量）。
#   配置目录由 CONFIG_PATH 指定，默认为 <cwd>/config/，包含：
#     - mcp_server.json   MCP 服务器定义
#     - group.json        组与路由
#     - system.json       系统/端口/JWT/认证/日志级别等
#     - api-tools.json    API-to-MCP 工具（可选）
#   下面列出的环境变量是代码实际识别的；除此之外的配置请写入对应 JSON 文件。

# ==================== 运行环境 ====================

# Node 环境（production 时启用生产模式）
NODE_ENV=production

# ==================== 配置文件目录 ====================

# 配置文件所在目录（代码读取 mcp_server.json / group.json / system.json / api-tools.json）
# 不设置时默认为 <cwd>/config/
CONFIG_PATH=/etc/mcp-knot/config

# ==================== 日志 ====================

# 日志级别：error | warn | info | debug
# 也可在 system.json 的 logging.logLevel 中设置
LOG_LEVEL=info

# 日志输出文件路径（可选；不设置则只输出到 stdout）
# LOG_FILE=/var/log/mcp-knot/app.log

# 调试模式（true 时输出更详细日志）
DEBUG=false

# ==================== 性能监控 ====================

# 是否启用性能监控（true/false）
PERFORMANCE_MONITORING=true

# 性能指标采集间隔（毫秒）
PERFORMANCE_COLLECT_INTERVAL=60000

# ==================== 核心性能开关（可选调优） ====================

# 以下均为可选开关，默认按代码内置策略；仅在需要调整时设置
# ENABLE_CACHING=true
# ENABLE_CONNECTION_POOLING=true
# ENABLE_LAZY_LOADING=true
# ENABLE_PARALLEL_INIT=true

# ==================== 安全 ====================

# 组 validationKey 的加密密钥（启用组级 validation 时必须设置，长度 >= 32 字符）
# 用于加密存储组的验证密钥
VALIDATION_KEY_SECRET=please-generate-a-secret-of-at-least-32-chars

# ==================== OAuth（入站 Protected Resource，可选） ====================
# 仅当 system.json 的 oauth 配置启用内置 Authorization Server 时需要

# 内置 AS 的 JWT 签名私钥（RS256，PEM 格式）
# OAUTH_INTERNAL_PRIVATE_KEY=-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----

# 公钥的 URL scheme（默认 http）
# OAUTH_PUBLIC_SCHEME=https

# ==================== 说明：以下配置走 JSON 文件，不要用环境变量 ====================
#
# 端口、JWT、CORS、速率限制、bcrypt、凭据等均在 system.json 中配置：
#   {
#     "server": { "port": 8181 },
#     "auth": {
#       "jwt": { "secret": "<>=32字符>", "expiresIn": "1h", "refreshExpiresIn": "7d" },
#       "users": { "admin": { "password": "<bcrypt哈希>", ... } }
#     },
#     "logging": { "logLevel": "info" },
#     "oauth": { ... }
#   }
# 详见 packages/share/src/config/schemas/system.schema.ts 与 backend/config/*.json.example。
